# PostgreSQL (Neon) — set this in your local .env
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# Sync URL for Alembic / scripts (same Neon URL, sync driver)
DATABASE_URL_SYNC=postgresql://user:password@host/dbname?sslmode=require

# FastAPI
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# Photo storage (local for now; swap to S3 later)
UPLOAD_DIR=./uploads
# S3_BUCKET=
# S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Django web (consumer of FastAPI)
DJANGO_SECRET_KEY=change-me-django-secret
DJANGO_DEBUG=True
FASTAPI_BASE_URL=http://127.0.0.1:8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Background jobs
VERIFICATION_PENDING_HOURS=24
SCHEDULER_ENABLED=True
