# PostgreSQL (Neon) — set real values in local .env (never commit secrets)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require
DATABASE_URL_SYNC=postgresql://user:password@host/dbname?sslmode=require

# FastAPI
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

UPLOAD_DIR=./uploads

# React web — also set web/.env VITE_API_URL
VITE_API_URL=http://127.0.0.1:8000

# Background jobs
VERIFICATION_PENDING_HOURS=24
SCHEDULER_ENABLED=True
